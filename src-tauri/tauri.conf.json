{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zega",
  "version": "0.1.0",
  "identifier": "earth.zega.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "zega",
        "decorations": false,
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://account.zega.earth; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.zega.earth/desktop/{channel}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2ODJFNkMxNjU3NERDNkUKUldSdTNIUmx3ZWFDdHRBMEo5ZDdkU25QckFxS0cxZUpsQmppMWlydmdLdHdDVW5tK2pvNElFUmQK"
    }
  }
}
